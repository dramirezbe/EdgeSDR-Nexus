# =============================================================================
# EdgeSDR-Nexus — Monorepo .gitignore
# Technologies: Node.js/TS, React/Vite, Python, C/CMake, Docker, nginx
# =============================================================================

# ---------------------
# OS & IDE
# ---------------------
.DS_Store
Thumbs.db
Desktop.ini
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/extensions.json
.idea/

# ---------------------
# Environment & Secrets
# ---------------------
.env
.env.*
!.env.example
!.env.production

# ---------------------
# Node.js (backend + frontend)
# ---------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------
# TypeScript compiled output
# ---------------------
dist/
*.tsbuildinfo

# ---------------------
# Vite (frontend)
# ---------------------
dist-ssr/
*.local

# ---------------------
# Python
# ---------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ---------------------
# Python virtual environments
# ---------------------
venv/
.venv/
env/
ENV/

# ---------------------
# C / CMake build artifacts (Edge-Node)
# ---------------------
Edge-Node/build/
Edge-Node/rf_app
Edge-Node/ltegps_app
*.o
*.a
*.so
*.dylib

# ---------------------
# Edge-Node runtime & logs
# ---------------------
Edge-Node/Logs/
Edge-Node/daemons/*.service
Edge-Node/daemons/*.timer
Edge-Node/venv/
Edge-Node/venv/.requirements.sha256

# ---------------------
# Docker
# ---------------------
.docker/

# ---------------------
# Backend data & logs
# ---------------------
backend/data/*.db
backend/data/*.db-*
backend/logs/
backend/backend-with-campaigns-endpoint.tar.gz

# ---------------------
# Backup artifacts (generated by deploy scripts)
# ---------------------
*.tar.gz
*.backup-*

# ---------------------
# Logs
# ---------------------
*.log
logs/

# ---------------------
# Testing & coverage
# ---------------------
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
.tox/
.cache/

# ---------------------
# Misc
